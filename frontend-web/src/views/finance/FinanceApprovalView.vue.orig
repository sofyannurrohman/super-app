      </div>

      <div v-else class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        <div v-for="salary in dailyWorkerSalaries" :key="salary.id" class="bg-white border-2 border-slate-100 rounded-[2rem] p-6 shadow-sm hover:shadow-xl transition-all">
