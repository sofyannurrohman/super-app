            </div>
          </div>

          <button
            @click="payDailyWorkerSalary(salary)"
            :disabled="isActionLoading === `pay_salary_${salary.id}`"
            class="w-full py-4 bg-emerald-50 hover:bg-emerald-100 text-emerald-600 rounded-xl font-black transition-colors flex items-center justify-center gap-2 disabled:opacity-50"
          >
            <span v-if="isActionLoading === `pay_salary_${salary.id}`" class="w-4 h-4 border-2 border-emerald-600 border-t-transparent rounded-full animate-spin"></span>
