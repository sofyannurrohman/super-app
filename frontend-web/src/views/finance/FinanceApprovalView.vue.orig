    <!-- Action Confirmation Modal -->
    <Teleport to="body">
      <Transition name="modal">
        <div
          v-if="showConfirmModal"
          class="fixed inset-0 z-[1000] flex items-center justify-center p-4"
        >
          <!-- Backdrop -->
          <div
            class="absolute inset-0 bg-slate-900/60 backdrop-blur-sm"
            @click="!isConfirmLoading && (showConfirmModal = false)"
          />

          <!-- Modal Content Box -->
          <div
            class="relative z-10 w-full max-w-sm bg-white rounded-3xl shadow-2xl p-6 border border-slate-100 flex flex-col items-center text-center"
          >
            <!-- Icon -->
            <div
              :class="[
                confirmType === 'approve'
                  ? 'bg-emerald-500/10 text-emerald-600'
                  : confirmType === 'reject' ? 'bg-rose-500/10 text-rose-600' : 'bg-amber-500/10 text-amber-600',
                'w-14 h-14 rounded-full flex items-center justify-center mb-4 shrink-0',
              ]"
            >
              <Check v-if="confirmType === 'approve'" class="w-7 h-7" />
              <X v-else-if="confirmType === 'reject'" class="w-7 h-7" />
              <AlertTriangle v-else class="w-7 h-7" />
            </div>

            <!-- Title & Message -->
            <h3 class="text-base font-black text-slate-900 leading-tight">
              {{ confirmType === 'approve' ? 'Setujui Setoran Tunai?' : (confirmType === 'reject' ? 'Tolak Setoran Tunai?' : 'Laporkan Selisih Setoran?') }}
            </h3>
            <p class="text-xs text-slate-500 font-semibold leading-relaxed mt-2 max-w-[280px]">
              {{
                confirmType === 'approve'
                  ? 'Apakah Anda yakin menyetujui setoran uang fisik ini? Saldo tagihan dan target omzet sales akan segera diperbarui.'
                  : (confirmType === 'reject' ? 'Apakah Anda yakin menolak setoran uang fisik ini? Status pembayaran akan diset menjadi Gagal.' : 'Faktur ini akan dikembalikan ke status Menunggu Crosscheck. Admin Nota harus menyesuaikan tagihan ini terlebih dahulu.')
              }}
            </p>

            <div v-if="confirmType === 'reject' || confirmType === 'discrepancy'" class="w-full mt-4 text-left">
              <label class="block text-xs font-bold text-slate-700 mb-1">{{ confirmType === 'reject' ? 'Alasan Penolakan (Opsional)' : 'Catatan Selisih (Wajib)' }}</label>
              <textarea
                v-model="rejectionReason"
                rows="3"
                class="w-full border border-slate-200 rounded-lg p-3 text-sm focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary transition-all"
                :placeholder="confirmType === 'reject' ? 'Contoh: Tulisan tidak jelas...' : 'Contoh: Uang fisik cuma ada Rp 8.500 karena retur...'"
              ></textarea>
            </div>

            <!-- Buttons -->
            <div class="flex gap-3 w-full mt-6">
              <button
                @click="showConfirmModal = false"
                :disabled="isConfirmLoading"
                class="flex-1 py-3 rounded-xl border border-slate-200 text-xs font-black text-slate-600 hover:bg-slate-50 transition-colors disabled:opacity-50"
              >
                BATAL
              </button>
              <button
                @click="executeAction"
                :disabled="isConfirmLoading"
                :class="[
                  confirmType === 'approve'
                    ? 'bg-emerald-600 hover:bg-emerald-500 shadow-emerald-600/20'
                    : 'bg-rose-600 hover:bg-rose-500 shadow-rose-600/20',
                  'flex-1 py-3 text-white rounded-xl text-xs font-black shadow-lg transition-all flex items-center justify-center gap-1.5 disabled:opacity-50',
                ]"
              >
                <span
                  v-if="isConfirmLoading"
                  class="w-4 h-4 border-2 border-white border-t-transparent rounded-full animate-spin"
                ></span>
                <template v-else>
                  YA, {{ confirmType === 'approve' ? 'SETUJUI' : 'TOLAK' }}
                </template>
              </button>
            </div>
          </div>
        </div>
      </Transition>
    </Teleport>
  </div>
</template>

<style scoped>
button {
  -webkit-tap-highlight-color: transparent;
}

/* Modal enter/leave transitions */
.modal-enter-active,
.modal-leave-active {
  transition: opacity 0.2s ease;
}
.modal-enter-from,
.modal-leave-to {
  opacity: 0;
}
