FROM node:24-alpine AS build
WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY . .
ARG VITE_API_BASE_URL=/api
ENV VITE_API_BASE_URL=${VITE_API_BASE_URL}
ARG VITE_APP_NAME="Karsa HR"
ARG VITE_APP_TAGLINE="Kelola tim. Gerakkan bisnis."
ARG VITE_APP_LOGO_URL=/brand.svg
ARG VITE_ENABLED_MODULES=hris,factory,warehouse,purchasing,sales,marketplace,branding,finance,rajatransport
ARG VITE_ENABLE_PKWT=false
ARG VITE_SUPPORT_EMAIL
ARG VITE_SUPPORT_WHATSAPP_PERSONAL
ARG VITE_SUPPORT_WHATSAPP_GROUP
ENV VITE_APP_LOGO_URL=${VITE_APP_LOGO_URL} VITE_ENABLED_MODULES=${VITE_ENABLED_MODULES} VITE_ENABLE_PKWT=${VITE_ENABLE_PKWT} VITE_APP_NAME=${VITE_APP_NAME} VITE_APP_TAGLINE=${VITE_APP_TAGLINE} VITE_SUPPORT_EMAIL=${VITE_SUPPORT_EMAIL} VITE_SUPPORT_WHATSAPP_PERSONAL=${VITE_SUPPORT_WHATSAPP_PERSONAL} VITE_SUPPORT_WHATSAPP_GROUP=${VITE_SUPPORT_WHATSAPP_GROUP}
RUN npm run build-only

FROM nginx:stable-alpine
COPY --from=build /app/dist/ /usr/share/nginx/html/
COPY nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
